MONGODB_URI=
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional. Comma separated emails that become administrators when they sign in.
ADMIN_EMAILS=
# Optional. Lets voice input use Google Gemini (server side only, never sent to the browser):
# understands commands the built-in rules don't, and transcribes in Brave/Firefox without the
# 63 MB on-device model. Sent to Google: audio or transcript, first name, project/tag names and a
# short list of open tasks due today or overdue (so it can answer "what's on my plate?").
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.5-flash-lite (fast; ~1.5 s per command). Lite models answer far
# faster than full Flash for short commands, and thinking is set to minimal either way.
GEMINI_MODEL=
# Optional. Asked too when the first model is slow or overloaded. Defaults to gemini-3.1-flash-lite.
GEMINI_FALLBACK_MODEL=
